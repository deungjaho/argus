.container { padding: 20rpx; }
.header { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; }
.section { margin-bottom: 16rpx; }
.label { font-size: 28rpx; color: #333; display: block; margin-bottom: 8rpx; }
.sub-label { font-size: 24rpx; color: #666; display: block; }
.reason-input {
  width: 100%; min-height: 120rpx; border: 1rpx solid #ddd;
  padding: 16rpx; font-size: 28rpx; border-radius: 8rpx;
  margin-bottom: 20rpx;
}
.contact-input {
  width: 100%; height: 80rpx; border: 1rpx solid #ddd;
  padding: 0 16rpx; font-size: 28rpx; border-radius: 8rpx;
}
.submit-btn {
  width: 100%; height: 88rpx; line-height: 88rpx;
  background: #07c160; color: #fff; font-size: 32rpx;
  border-radius: 8rpx; margin-top: 20rpx;
}
.submit-btn[disabled] { background: #ccc; }
.spacer { height: 2000rpx; }
.upload-btn {
  width: 100%; height: 80rpx; line-height: 80rpx;
  background: #f5f5f5; color: #333; font-size: 28rpx;
  border-radius: 8rpx;
}
.status-area { margin-top: 20rpx; padding: 16rpx; background: #f9f9f9; }
.status-text { font-size: 28rpx; color: #333; display: block; }
.keyboard-count { font-size: 24rpx; color: #999; display: block; }
.run-id { font-size: 24rpx; color: #0066cc; display: block; }
