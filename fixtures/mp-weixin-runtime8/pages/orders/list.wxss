.container { padding: 20rpx; }
.header { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; }
.skeleton { padding: 40rpx; text-align: center; }
.loading-text { font-size: 28rpx; color: #999; }
.orders { }
.order-row {
  display: flex; align-items: center; padding: 16rpx;
  border-bottom: 1rpx solid #eee;
}
.order-id { font-size: 28rpx; flex: 1; }
.order-status { font-size: 24rpx; color: #666; flex: 1; }
.detail-btn {
  width: 160rpx; height: 60rpx; line-height: 60rpx;
  background: #07c160; color: #fff; font-size: 24rpx;
  border-radius: 4rpx; margin: 0;
}
.error-trigger {
  width: 100%; height: 80rpx; line-height: 80rpx;
  background: #f5f5f5; font-size: 28rpx; margin-top: 20rpx;
}
