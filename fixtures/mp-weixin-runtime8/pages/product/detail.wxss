.container { padding: 20rpx; }
.header { font-size: 36rpx; font-weight: bold; margin-bottom: 20rpx; }
.product-info { margin-bottom: 20rpx; }
.product-id { font-size: 28rpx; color: #666; display: block; }
.product-name { font-size: 32rpx; color: #333; display: block; }
.diag-area { padding: 16rpx; background: #f0f0f0; border-radius: 8rpx; margin-bottom: 20rpx; }
.diag-text { font-size: 24rpx; color: #666; display: block; }
.actions { display: flex; gap: 20rpx; margin-bottom: 20rpx; }
.local-home-btn { flex: 1; height: 80rpx; line-height: 80rpx; background: #e8e8e8; font-size: 28rpx; }
.nav-home-btn { flex: 1; height: 80rpx; line-height: 80rpx; background: #07c160; color: #fff; font-size: 28rpx; }
.reentry-btn { width: 100%; height: 80rpx; line-height: 80rpx; background: #f5f5f5; font-size: 28rpx; }
