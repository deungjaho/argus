<!-- Runtime8 Fixture: product detail page (Scenario B) -->
<!-- Contains two buttons both named "首页" — one local section link, one tab navigation -->
<view class="container">
  <view class="header">商品详情</view>
  <view class="product-info">
    <text class="product-id">商品ID: {{productId}}</text>
    <text class="product-name">{{productName}}</text>
  </view>

  <!-- Diagnostic region: entry kind, query, scene -->
  <view class="diag-area">
    <text class="diag-text">entry_kind: {{entryKind}}</text>
    <text class="diag-text">query: {{queryStr}}</text>
    <text class="diag-text">scene: {{scene}}</text>
  </view>

  <!-- Two "首页" buttons — one local section link, one real navigation -->
  <view class="actions">
    <button class="local-home-btn" bindtap="scrollToTop">首页</button>
    <button class="nav-home-btn" bindtap="goHome">首页</button>
  </view>

  <button class="reentry-btn" bindtap="simulateReentry">模拟重新进入</button>
</view>
